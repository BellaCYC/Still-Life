{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StillLife",
  "version": "1.2.0",
  "identifier": "io.github.bellacyc.stilllife",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "StillLife",
        "width": 960,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "center": true,
        "zoomHotkeysEnabled": true
      },
      {
        "label": "island",
        "url": "island.html",
        "title": "StillLife island",
        "width": 1080,
        "height": 680,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "BellaCYC",
    "shortDescription": "Every note, quietly in orbit.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  }
}
